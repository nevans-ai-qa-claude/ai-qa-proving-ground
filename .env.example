# Proving ground fault injection
#
# Nothing here is read from a .env file at runtime — these are plain environment
# variables, so they compose with CI matrices and with the corpus generator without
# a config-file layer in between. This file documents them; copy the lines you need.

# ---------------------------------------------------------------------------
# DEFECTS — which deterministic faults are active.
#   none            no defects (clean baseline; the suite should be fully green)
#   all             every defect in contracts/defects.json
#   D001,D006,D080  an explicit list
# ---------------------------------------------------------------------------
DEFECTS=none

# ---------------------------------------------------------------------------
# FLAKES — which nondeterministic faults are active, and at what probability.
#   none            no flake injection
#   all             every flake at its defaultProbability from the manifest
#   F001:0.5,F002   explicit ids, with an optional probability override
# ---------------------------------------------------------------------------
FLAKES=none

# ---------------------------------------------------------------------------
# FLAKE_SEED — PRNG seed for flake injection.
#
# Same seed + same FLAKES config reproduces the same sequence of flake decisions,
# but ONLY on a single worker. Under parallel workers the order in which requests
# reach the server is not deterministic, so the seed narrows variance rather than
# eliminating it. Use `--workers=1` when you need a bit-for-bit repeat.
# ---------------------------------------------------------------------------
FLAKE_SEED=1337

PORT=3100
