{
  "name": "proving-ground",
  "version": "1.0.0",
  "private": true,
  "description": "Project 0 of the AI-QA portfolio: a deliberately defective web app and API, with toggleable fault injection and a baseline Playwright suite that emits run events conforming to the shared contract.",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",

    "test": "playwright test",
    "test:clean": "cross-env DEFECTS=none FLAKES=none playwright test",
    "test:defects": "cross-env DEFECTS=all FLAKES=none playwright test",
    "test:product": "cross-env DEFECTS=D001,D002,D003,D004,D005,D006,D007,D008,D009,D010,D011,D012 FLAKES=none playwright test",
    "test:flaky": "cross-env DEFECTS=none FLAKES=all playwright test",
    "test:chaos": "cross-env DEFECTS=all FLAKES=all playwright test",
    "test:reorder": "cross-env DEFECTS=none FLAKES=none CATALOG_ORDER=reverse playwright test",
    "test:parallel": "cross-env DEFECTS=none FLAKES=none WORKERS=4 playwright test",

    "check:consistency": "tsx scripts/check-consistency.ts",
    "corpus": "tsx scripts/generate-corpus.ts",
    "validate:events": "tsx scripts/validate-events.ts",
    "verify:manifest": "tsx scripts/verify-manifest.ts"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "cross-env": "^7.0.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
